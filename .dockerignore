# Build context for every image is the repository root (the backend and the
# judge both need shared/), so everything heavy or secret is kept out of it
# here. Whatever survives this file is uploaded to the daemon on every build.

.git
.github
.idea
.vscode

# Local environments and caches
**/.venv
**/node_modules
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/coverage
**/htmlcov
frontend/dist

# Secrets and local state
.env
.env.*
!.env.example
data
backend/django_app/media
infra/nginx/certs

# Working documents, not part of any image
mocks
plans
*.md
!README.md
