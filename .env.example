# Copy to .env and fill in. Values below are development defaults; every line
# marked "prod only" is read by settings/prod.py or docker-compose.prod.yml and
# has no default — the container refuses to start without it.

# Backend
SECRET_KEY=your-django-secret-key-here
# Every hostname the site answers on. Prod: the domain, with and without www.
ALLOWED_HOSTS=localhost,127.0.0.1
# Prod only. Scheme + host of every origin allowed to post to the admin.
# Missing or wrong = 403 on the admin login.
CSRF_TRUSTED_ORIGINS=https://your-domain.com
# Prod only. DEBUG / INFO / WARNING / ERROR. INFO for normal operation.
LOG_LEVEL=INFO
# Prod only. Leave empty: the app and the API share one origin behind nginx.
# Fill only if a browser app on another domain has to call this API.
CORS_ALLOWED_ORIGINS=

# Database
POSTGRES_DB=codegard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/codegard

# Redis
REDIS_PASSWORD=your-redis-password-here
# The one Redis address, shared by Django, Celery and the judge. Must carry the
# password above, or the judge refuses to start and nothing gets judged.
REDIS_URL=redis://:your-redis-password-here@redis:6379/0
# Prod only. Ceiling for Redis itself, so it cannot eat the machine. Pick it
# from the server's RAM: roughly 768mb on 12 GB, 512mb on 4 GB.
REDIS_MAXMEMORY=768mb

# Prod only. Process counts, sized per machine — see the notes in
# docker-compose.prod.yml. These are for a 2-core server.
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=2
# One submission judged at a time: judging takes a whole core, and the site
# needs the other one.
JUDGE_WORKERS=1

# Flower (Celery monitoring UI — basic auth)
FLOWER_USER=admin
FLOWER_PASSWORD=your-flower-password-here

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Public bucket domain (R2 bucket Settings -> Public Development URL, or a
# Custom Domain). REQUIRED when R2 is enabled:
# URLs are unsigned/public, so without it images 404 and the app won't start.
R2_CUSTOM_DOMAIN=your_public_bucket_domain

# Frontend
# Relative path — same origin in dev (Vite proxy) and prod (nginx). Baked at build time.
VITE_API_URL=/api
# Dev only: where Vite proxies /api and /ws. Unused in prod.
VITE_DEV_PROXY_TARGET=http://backend:8000

# OAuth (Google / GitHub)
# Empty is a working setting, not a missing one: a provider without credentials
# is simply switched off and its button never appears. Fill a pair to enable it,
# as in the commented lines.
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your_google_client_secret
# GITHUB_OAUTH_CLIENT_ID=Iv1.your_github_client_id
# GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Browser-facing origin OAuth callbacks are built on (dev: Vite server)
OAUTH_REDIRECT_BASE=http://localhost:5173
