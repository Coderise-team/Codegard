# Backend
SECRET_KEY=your-django-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
# Prod only. Scheme + host of every origin allowed to post to the admin.
# Missing or wrong = 403 on the admin login.
CSRF_TRUSTED_ORIGINS=https://your-domain.com
# Prod only. DEBUG / INFO / WARNING / ERROR. INFO for normal operation.
LOG_LEVEL=INFO
# Prod only. Leave empty: the app and the API share one origin behind nginx.
# Fill only if a browser app on another domain has to call this API.
CORS_ALLOWED_ORIGINS=

# Database
POSTGRES_DB=codegard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@postgres:5432/codegard

# Redis
REDIS_PASSWORD=your-redis-password-here

# Flower (Celery monitoring UI — basic auth)
FLOWER_USER=admin
FLOWER_PASSWORD=your-flower-password-here

# Judge
JUDGE_SECRET_KEY=your-judge-secret-key-here
JUDGE_URL=http://judge:8001

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Public bucket domain (R2 bucket Settings -> Public Development URL, or a
# Custom Domain). REQUIRED when R2 is enabled:
# URLs are unsigned/public, so without it images 404 and the app won't start.
R2_CUSTOM_DOMAIN=your_public_bucket_domain

# Frontend
# Relative path — same origin in dev (Vite proxy) and prod (nginx). Baked at build time.
VITE_API_URL=/api
# Dev only: where Vite proxies /api and /ws. Unused in prod.
VITE_DEV_PROXY_TARGET=http://backend:8000

# OAuth (Google / GitHub) - empty credentials disable the provider
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Browser-facing origin OAuth callbacks are built on (dev: Vite server)
OAUTH_REDIRECT_BASE=http://localhost:5173
